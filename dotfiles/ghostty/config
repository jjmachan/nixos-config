# Theme
theme = tokyonight
# To hide the bar entirely (but tabs still work via keybinds)
macos-titlebar-style = hidden
macos-option-as-alt = true

# Trim the window padding from ghostty's default of 2 to 1 on every edge.
# A single value sets both sides; use "top,bottom" / "left,right" to split them.
window-padding-x = 1
window-padding-y = 1